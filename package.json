{
  "name": "blackjack",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "preview": "npm --workspace apps/web run preview",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm --workspace apps/web exec tsc --noEmit"
  }
}
